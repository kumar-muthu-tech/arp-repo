---
import Base from '../../layouts/Base.astro';
import { agents } from '../../data/agents';
---
<Base title="Agents">
  <section>
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-cyan-600">Available tools</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950 md:text-5xl">Agents</h1>
    <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-600">Choose an agent to learn more about how it can support your workflow.</p>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {agents.map((agent) => (
          <a href={agent.link} class="border border-slate-200 p-5 transition-colors hover:border-cyan-500 hover:bg-cyan-50">
          <h2 class="text-xl font-semibold text-slate-950">{agent.name}</h2>
          <p class="mt-2 text-sm text-slate-500">{agent.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>